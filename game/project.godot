; Engine configuration file.
; Godot 4.5

config_version=5

[application]

config/name="QuestNotes"
config/description="Upload your notes. Get a dungeon."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.035, 0.051, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/game_state.gd"
Api="*res://scripts/api.gd"
Sfx="*res://scripts/sfx.gd"
Transition="*res://scripts/transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.024, 0.02, 0.031, 1)
